diff --git a/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
new file mode 100644
index 0000000..0f2b00d
--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,38 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.h2.jdbcx.JdbcDataSource;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+
+class AccountRepositoryTest {
+
+    @Test
+    void findByOwnerUsesParameterizedQuery() {
+        var repo = newRepository();
+        repo.save(new Account("A1", "Alice", java.math.BigDecimal.ONE, false));
+        repo.save(new Account("B1", "Bob", java.math.BigDecimal.TEN, false));
+
+        assertEquals(0, repo.findByOwner("Alice' OR '1'='1").size());
+        assertEquals(1, repo.findByOwner("Alice").size());
+    }
+
+    @Test
+    void findOverdrawnUsesParameterizedQuery() {
+        var repo = newRepository();
+        repo.save(new Account("A1", "Alice", java.math.BigDecimal.valueOf(-1), false));
+        repo.save(new Account("B1", "Bob", java.math.BigDecimal.valueOf(-2), false));
+
+        assertEquals(0, repo.findOverdrawn("A%' OR '1'='1").size());
+        assertEquals(1, repo.findOverdrawn("A").size());
+    }
+
+    private static AccountRepository newRepository() {
+        var ds = new JdbcDataSource();
+        ds.setURL("jdbc:h2:mem:test-" + System.nanoTime() + ";DB_CLOSE_DELAY=-1");
+        var repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        return repo;
+    }
+}
