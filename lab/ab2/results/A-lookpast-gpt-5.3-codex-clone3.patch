@@ -0,0 +1,30 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    @Test
+    void searchMethodsUseBoundParameters() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:repo-test;DB_CLOSE_DELAY=-1", "sa", "");
+        var repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        repo.save(new Account("A001", "Alice", new BigDecimal("100.00"), false));
+        repo.save(new Account("A002", "Bob", new BigDecimal("-5.00"), false));
+
+        List<Account> injectedOwner = repo.findByOwner("' OR '1'='1");
+        List<Account> injectedPrefix = repo.findOverdrawn("' OR '1'='1");
+
+        assertTrue(injectedOwner.isEmpty());
+        assertTrue(injectedPrefix.isEmpty());
+        assertEquals(1, repo.findByOwner("Alice").size());
+    }
+}
