 package com.example.ledger.common;
 
 import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
 
-import org.apache.commons.text.StringSubstitutor;
 import org.springframework.stereotype.Component;
 
 /**
@@ -12,9 +13,24 @@ import org.springframework.stereotype.Component;
 @Component
 public class NoticeRenderer {
 
+    private static final Pattern VARIABLE = Pattern.compile("\\$\\{([^}]+)}");
+
     public String render(String template, Map<String, String> values) {
-        StringSubstitutor substitutor = StringSubstitutor.createInterpolator();
-        substitutor.setVariableResolver(new FallbackLookup(values, substitutor.getStringLookup()));
-        return substitutor.replace(template);
+        if (template == null || template.isEmpty()) {
+            return "";
+        }
+        Matcher matcher = VARIABLE.matcher(template);
+        StringBuffer out = new StringBuffer();
+        while (matcher.find()) {
+            String placeholder = matcher.group(1).trim();
+            int formatStart = placeholder.indexOf(':');
+            if (formatStart >= 0) {
+                placeholder = placeholder.substring(0, formatStart);
+            }
+            String replacement = values.getOrDefault(placeholder, "");
+            matcher.appendReplacement(out, Matcher.quoteReplacement(replacement));
+        }
+        matcher.appendTail(out);
+        return out.toString();
     }
 }
