index 0000000..4f7f115
--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,56 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+import javax.sql.DataSource;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.embedded.EmbeddedDatabaseBuilder;
+import org.springframework.jdbc.datasource.embedded.EmbeddedDatabaseType;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setup() {
+        DataSource ds = new EmbeddedDatabaseBuilder()
+                .setType(EmbeddedDatabaseType.H2)
+                .build();
+        repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+    }
+
+    @Test
+    void savesAndFindsByOwnerSafely() {
+        repo.save(new Account("ACC1", "Alice", new BigDecimal("100.00"), false));
+        repo.save(new Account("ACC2", "Bob", new BigDecimal("-50.00"), false));
+
+        List<Account> found = repo.findByOwner("Alice");
+        assertEquals(1, found.size());
+        assertEquals("ACC1", found.get(0).id());
+
+        List<Account> injected = repo.findByOwner("' or '1'='1");
+        assertTrue(injected.isEmpty());
+    }
+
+    @Test
+    void findsOverdrawnSafely() {
+        repo.save(new Account("ACC1", "Alice Smith", new BigDecimal("-25.00"), false));
+        repo.save(new Account("ACC2", "Alice Jones", new BigDecimal("100.00"), false));
+        repo.save(new Account("ACC3", "Bob", new BigDecimal("-10.00"), false));
+
+        List<Account> overdrawn = repo.findOverdrawn("Alice");
+        assertEquals(1, overdrawn.size());
+        assertEquals("ACC1", overdrawn.get(0).id());
+
+        List<Account> injected = repo.findOverdrawn("' or '1'='1");
+        assertTrue(injected.isEmpty());
+    }
+}
