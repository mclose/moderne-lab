@@ -0,0 +1,49 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:accounts-" + System.nanoTime() + ";DB_CLOSE_DELAY=-1");
+        repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        repo.save(new Account("A1", "Smith", new BigDecimal("-5.00"), false));
+        repo.save(new Account("A2", "Smithers", new BigDecimal("-7.00"), false));
+        repo.save(new Account("A3", "Jones", new BigDecimal("10.00"), false));
+    }
+
+    @Test
+    void findByOwnerMatchesExactly() {
+        assertEquals(1, repo.findByOwner("Smith").size());
+    }
+
+    @Test
+    void findByOwnerTreatsInjectionAsData() {
+        assertEquals(0, repo.findByOwner("x' or '1'='1").size());
+        assertEquals(0, repo.findByOwner("Smith' or owner like '%").size());
+    }
+
+    @Test
+    void findOverdrawnFiltersByPrefix() {
+        assertEquals(2, repo.findOverdrawn("Smith").size());
+        assertEquals(0, repo.findOverdrawn("Jones").size());
+    }
+
+    @Test
+    void findOverdrawnTreatsInjectionAndWildcardsAsLiterals() {
+        assertEquals(0, repo.findOverdrawn("' or '1'='1").size());
+        assertEquals(0, repo.findOverdrawn("%").size());
+        assertEquals(0, repo.findOverdrawn("_mith").size());
+    }
+}
