--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,37 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repository;
+
+    @BeforeEach
+    void setUp() {
+        var dataSource = new DriverManagerDataSource(
+                "jdbc:h2:mem:accounts;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DATABASE_TO_UPPER=false");
+        repository = new AccountRepository(new JdbcTemplate(dataSource));
+        repository.createSchema();
+        repository.save(new Account("DE001", "A. N. Other", new BigDecimal("100.00"), false));
+        repository.save(new Account("DE002", "B. Doe", new BigDecimal("-7.00"), false));
+    }
+
+    @Test
+    void doesNotAllowInjectionInOwnerSearch() {
+        assertEquals(0, repository.findByOwner("' OR 1=1 -- ").size());
+        assertEquals(1, repository.findByOwner("A. N. Other").size());
+    }
+
+    @Test
+    void doesNotAllowInjectionInOverdrawnSearch() {
+        assertEquals(0, repository.findOverdrawn("B%' OR 1=1 -- ").size());
+        assertEquals(1, repository.findOverdrawn("B").size());
+    }
+}
