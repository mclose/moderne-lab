--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,37 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private static AccountRepository repository() {
+        String dbName = "account_repo_" + UUID.randomUUID().toString().replace("-", "");
+        JdbcTemplate jdbc = new JdbcTemplate(new DriverManagerDataSource("jdbc:h2:mem:" + dbName + ";DB_CLOSE_DELAY=-1"));
+        AccountRepository repository = new AccountRepository(jdbc);
+        repository.createSchema();
+        repository.save(new Account("GB01", "Alice", new BigDecimal("100.00"), false));
+        repository.save(new Account("GB02", "Bob", new BigDecimal("-10.00"), false));
+        return repository;
+    }
+
+    @Test
+    void findByOwnerTreatsInputAsData() {
+        AccountRepository repository = repository();
+        assertEquals(0, repository.findByOwner("' OR '1'='1").size());
+        assertEquals(1, repository.findByOwner("Alice").size());
+    }
+
+    @Test
+    void findOverdrawnTreatsPrefixAsData() {
+        AccountRepository repository = repository();
+        assertEquals(0, repository.findOverdrawn("B' OR '1'='1").size());
+        assertEquals(1, repository.findOverdrawn("B").size());
+    }
+}
