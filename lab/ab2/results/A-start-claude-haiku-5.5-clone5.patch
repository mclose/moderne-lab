@@ -0,0 +1,38 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var dataSource = new DriverManagerDataSource("jdbc:h2:mem:" + java.util.UUID.randomUUID() + ";DB_CLOSE_DELAY=-1");
+        repo = new AccountRepository(new JdbcTemplate(dataSource));
+        repo.createSchema();
+        repo.save(new Account("GB01", "Alice", new BigDecimal("-5.00"), false));
+        repo.save(new Account("GB02", "Bob", new BigDecimal("-7.00"), false));
+        repo.save(new Account("GB03", "Alice Jr", new BigDecimal("10.00"), false));
+    }
+
+    @Test
+    void findByOwnerMatchesExactlyAndIgnoresQuotes() {
+        assertEquals(1, repo.findByOwner("Alice").size());
+        assertEquals(0, repo.findByOwner("x' or '1'='1").size());
+    }
+
+    @Test
+    void findOverdrawnTreatsPrefixLiterally() {
+        assertEquals(1, repo.findOverdrawn("A").size());
+        assertEquals(0, repo.findOverdrawn("' or '1'='1").size());
+        assertEquals(0, repo.findOverdrawn("%").size());
+    }
+}
