+ * Only template values, date, env and sys lookups are enabled. The default interpolator also
+ * resolves script:, dns: and url:, which lets a template execute code or make network calls.
  */
 @Component
 public class NoticeRenderer {
 
+    private static final StringLookup SAFE_LOOKUPS = StringLookupFactory.INSTANCE.interpolatorStringLookup(
+            Map.of(
+                    "date", StringLookupFactory.INSTANCE.dateStringLookup(),
+                    "env", StringLookupFactory.INSTANCE.environmentVariableStringLookup(),
+                    "sys", StringLookupFactory.INSTANCE.systemPropertyStringLookup()),
+            null,
+            false);
+
