@@ -0,0 +1,36 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repository;
+
+    @BeforeEach
+    void setUp() {
+        var dataSource = new DriverManagerDataSource("jdbc:h2:mem:account-repository;DB_CLOSE_DELAY=-1");
+        repository = new AccountRepository(new JdbcTemplate(dataSource));
+        repository.createSchema();
+        repository.save(new Account("A1", "Alice", new BigDecimal("-10.00"), false));
+        repository.save(new Account("A2", "Alice", new BigDecimal("-20.00"), true));
+    }
+
+    @Test
+    void ownerSearchTreatsInputAsData() {
+        assertEquals(0, repository.findByOwner("' OR 1=1 --").size());
+        assertEquals(1, repository.findByOwner("Alice").size());
+    }
+
+    @Test
+    void overdraftSearchTreatsPrefixAsData() {
+        assertEquals(0, repository.findOverdrawn("' OR 1=1 --").size());
+        assertEquals(1, repository.findOverdrawn("Ali").size());
+    }
+}
