+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository accounts;
+
+    @BeforeEach
+    void setUp() {
+        var dataSource = new DriverManagerDataSource("jdbc:h2:mem:account-repository;DB_CLOSE_DELAY=-1", "sa", "");
+        accounts = new AccountRepository(new JdbcTemplate(dataSource));
+        accounts.createSchema();
+        accounts.save(new Account("A1", "Alice", new BigDecimal("-10.00"), false));
+        accounts.save(new Account("A2", "Bob", new BigDecimal("-20.00"), false));
+    }
+
+    @Test
+    void treatsOwnerSearchInputAsData() {
+        assertEquals(0, accounts.findByOwner("' OR '1'='1").size());
+    }
+
+    @Test
+    void treatsOverdrawnPrefixAsData() {
+        assertEquals(0, accounts.findOverdrawn("' OR '1'='1").size());
+    }
+}
