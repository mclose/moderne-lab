+
+    /** Rejects absolute paths and ".." segments that would write outside the bundle directory. */
+    private static Path safeEntryTarget(Path bundleDir, String entryName) throws IOException {
+        var target = bundleDir.resolve(entryName).normalize();
+        if (!target.startsWith(bundleDir) || target.equals(bundleDir)) {
