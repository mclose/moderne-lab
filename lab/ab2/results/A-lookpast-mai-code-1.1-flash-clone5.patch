+import java.time.format.DateTimeFormatter;
 import java.util.Map;
 
 import org.apache.commons.text.StringSubstitutor;
@@ -8,13 +10,33 @@ import org.springframework.stereotype.Component;
 /**
  * Renders customer notices from templates kept by operations, e.g.
  * "Dear ${name}, your balance on ${date:yyyy-MM-dd} is ${balance}."
+ *
+ * We intentionally allow only explicit variable values and a safe date formatter; no default system/env lookups.
  */
 @Component
 public class NoticeRenderer {
 
     public String render(String template, Map<String, String> values) {
-        StringSubstitutor substitutor = StringSubstitutor.createInterpolator();
-        substitutor.setVariableResolver(new FallbackLookup(values, substitutor.getStringLookup()));
+        StringSubstitutor substitutor = new StringSubstitutor(key -> lookupValue(values, key));
+        substitutor.setEnableSubstitutionInVariables(false);
         return substitutor.replace(template);
     }
+
+    private static String lookupValue(Map<String, String> values, String key) {
+        String value = values.get(key);
+        if (value != null) {
+            return value;
+        }
+        if (key.startsWith("date:")) {
+            String pattern = key.substring("date:".length());
+            if (pattern.isBlank()) {
+                return LocalDate.now().format(DateTimeFormatter.ISO_LOCAL_DATE);
+            }
+            return LocalDate.now().format(DateTimeFormatter.ofPattern(pattern));
+        }
+        if (key.startsWith("env:")) {
+            return null;
+        }
+        return null;
+    }
 }
