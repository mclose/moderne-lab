@@ -0,0 +1,38 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:" + java.util.UUID.randomUUID() + ";DB_CLOSE_DELAY=-1");
+        repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        repo.save(new Account("GB01", "J. Doe", new BigDecimal("-5.00"), false));
+        repo.save(new Account("GB02", "A. N. Other", new BigDecimal("10.00"), false));
+        repo.save(new Account("GB03", "Jane Doe", new BigDecimal("-1.00"), true));
+    }
+
+    @Test
+    void findByOwnerTreatsInputAsData() {
+        assertEquals(1, repo.findByOwner("J. Doe").size());
+        assertEquals(0, repo.findByOwner("x' or '1'='1").size());
+    }
+
+    @Test
+    void findOverdrawnTreatsPrefixAsLiteral() {
+        assertEquals(1, repo.findOverdrawn("J.").size());
+        assertEquals(0, repo.findOverdrawn("%").size());
+        assertEquals(0, repo.findOverdrawn("x' or '1'='1").size());
+    }
+}
