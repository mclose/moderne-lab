index 0000000..329dd91
--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,41 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repository;
+
+    @BeforeEach
+    void setUp() {
+        var dataSource = new DriverManagerDataSource(
+                "jdbc:h2:mem:account-repository-" + UUID.randomUUID() + ";MODE=LEGACY;DB_CLOSE_DELAY=-1",
+                "sa",
+                "");
+        repository = new AccountRepository(new JdbcTemplate(dataSource));
+        repository.createSchema();
+        repository.save(new Account("GB01", "A. N. Other", new BigDecimal("100.00"), false));
+        repository.save(new Account("GB02", "J. Doe", new BigDecimal("-25.00"), false));
+        repository.save(new Account("GB03", "O'Reilly", new BigDecimal("-30.00"), false));
+    }
+
+    @Test
+    void findByOwnerUsesParameters() {
+        assertEquals(0, repository.findByOwner("A. N. Other' OR '1'='1").size());
+        assertEquals(1, repository.findByOwner("O'Reilly").size());
+    }
+
+    @Test
+    void findOverdrawnUsesParameters() {
+        assertEquals(0, repository.findOverdrawn("J' OR '1'='1").size());
+        assertEquals(2, repository.findOverdrawn("").size());
+    }
+}
