     }
+
+    private static String escapeLikePrefix(String ownerPrefix) {
+        return String.valueOf(ownerPrefix)
+                .replace("\\", "\\\\")
+                .replace("%", "\\%")
+                .replace("_", "\\_")
+                + "%";
+    }
 }
