--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,25 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    @Test
+    void doesNotAllowSqlInjectionInOwnerFilters() {
+        var dataSource = new DriverManagerDataSource(
+                "jdbc:h2:mem:account-repo-test;MODE=PostgreSQL;DB_CLOSE_DELAY=-1", "sa", "");
+        var repository = new AccountRepository(new JdbcTemplate(dataSource));
+        repository.createSchema();
+        repository.save(new Account("A1", "Alice", new BigDecimal("100.00"), false));
+        repository.save(new Account("A2", "Bob", new BigDecimal("-10.00"), false));
+
+        assertEquals(0, repository.findByOwner("' OR '1'='1").size());
+        assertEquals(0, repository.findOverdrawn("' OR '1'='1 --").size());
+    }
+}
