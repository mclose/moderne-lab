@@ -0,0 +1,40 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:" + getClass().getSimpleName() + ";DB_CLOSE_DELAY=-1");
+        repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        repo.save(new Account("GB01", "J. Doe", new BigDecimal("-5.00"), false));
+        repo.save(new Account("GB02", "A. N. Other", new BigDecimal("1200.00"), false));
+    }
+
+    @Test
+    void findsByOwnerAsPlainValue() {
+        assertEquals(1, repo.findByOwner("J. Doe").size());
+    }
+
+    @Test
+    void ownerInputIsNotInterpretedAsSql() {
+        assertEquals(0, repo.findByOwner("x' or '1'='1").size());
+    }
+
+    @Test
+    void overdrawnPrefixIsNotInterpretedAsSql() {
+        assertEquals(0, repo.findOverdrawn("' or '1'='1").size());
+        assertEquals(1, repo.findOverdrawn("J.").size());
+    }
+}
