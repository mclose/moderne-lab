 /**
  * Renders customer notices from templates kept by operations, e.g.
  * "Dear ${name}, your balance on ${date:yyyy-MM-dd} is ${balance}."
+ * Only template values and the date: lookup are resolved; the default
+ * interpolator lookups (script:, dns:, url:, env:, ...) are disabled
+ * because templates are not trusted input.
  */
 @Component
 public class NoticeRenderer {
 
+    private static final StringLookup DATE_LOOKUP = StringLookupFactory.INSTANCE.dateStringLookup();
+
+    private static final StringLookup SAFE_LOOKUPS = key ->
+            key.startsWith("date:") ? DATE_LOOKUP.lookup(key.substring("date:".length())) : null;
+
     public String render(String template, Map<String, String> values) {
-        StringSubstitutor substitutor = StringSubstitutor.createInterpolator();
