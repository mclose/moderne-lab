@@ -0,0 +1,41 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:repo-" + System.nanoTime() + ";DB_CLOSE_DELAY=-1", "sa", "");
+        repo = new AccountRepository(new JdbcTemplate(ds));
+        repo.createSchema();
+        repo.save(new Account("GB01", "J. Doe", new BigDecimal("-5.00"), false));
+        repo.save(new Account("GB02", "A. N. Other", new BigDecimal("10.00"), false));
+        repo.save(new Account("GB03", "Secret", new BigDecimal("-1.00"), true));
+    }
+
+    @Test
+    void findsByOwnerWithoutInterpretingInput() {
+        assertEquals(1, repo.findByOwner("J. Doe").size());
+        assertTrue(repo.findByOwner("x' or '1'='1").isEmpty());
+    }
+
+    @Test
+    void findsOverdrawnByPrefix() {
+        List<Account> found = repo.findOverdrawn("J.");
+        assertEquals(1, found.size());
+        assertEquals("GB01", found.get(0).id());
+        assertTrue(repo.findOverdrawn("' or '1'='1").isEmpty());
+    }
+}
