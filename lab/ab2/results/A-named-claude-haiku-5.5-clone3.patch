diff --git a/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
new file mode 100644
index 0000000..cd5b620
--- /dev/null
+++ b/ledger-accounts/src/test/java/com/example/ledger/accounts/AccountRepositoryTest.java
@@ -0,0 +1,48 @@
+package com.example.ledger.accounts;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+
+class AccountRepositoryTest {
+
+    private JdbcTemplate jdbc;
+    private AccountRepository repo;
+
+    @BeforeEach
+    void setUp() {
+        var ds = new DriverManagerDataSource("jdbc:h2:mem:repo-" + System.nanoTime() + ";DB_CLOSE_DELAY=-1");
+        jdbc = new JdbcTemplate(ds);
+        repo = new AccountRepository(jdbc);
+        repo.createSchema();
+        repo.save(new Account("GB01", "J. Doe", new BigDecimal("-5.00"), false));
+        repo.save(new Account("GB02", "A. N. Other", new BigDecimal("1200.00"), false));
+        repo.save(new Account("HOLD1", "audit-hold", new BigDecimal("-950000.00"), true));
+    }
+
+    @Test
+    void searchByOwnerTreatsInputAsData() {
+        assertEquals(1, repo.findByOwner("A. N. Other").size());
+        assertEquals(0, repo.findByOwner("x' or '1'='1").size());
+    }
+
+    @Test
+    void overdrawnPrefixIsNotSqlAndNotWildcard() {
+        assertEquals(1, repo.findOverdrawn("J.").size());
+        assertEquals(0, repo.findOverdrawn("' or '1'='1").size());
+        assertEquals(0, repo.findOverdrawn("%").size());
+        assertEquals(0, repo.findOverdrawn("audit").size());
+    }
+
+    @Test
+    void tableSurvivesInjectionAttempts() {
+        repo.findByOwner("x'; drop table account; --");
+        repo.findOverdrawn("x'; drop table account; --");
+        assertEquals(3, jdbc.queryForObject("select count(*) from account", Integer.class));
+    }
+}
