+    /** Rejects absolute paths and ".." segments so a zip entry cannot escape the bundle directory. */
+    private static Path safeEntryPath(Path bundleDir, String entryName) throws IOException {
+        var root = bundleDir.toAbsolutePath().normalize();
+        var relative = Path.of(entryName);
+        if (relative.isAbsolute()) {
+            throw new IOException("zip entry is outside the bundle directory: " + entryName);
+        }
+        for (var part : relative) {
+            if ("..".equals(part.toString())) {
+                throw new IOException("zip entry is outside the bundle directory: " + entryName);
+            }
+        }
+        var target = root.resolve(relative).normalize();
+        if (!target.startsWith(root) || target.equals(root)) {
+            throw new IOException("zip entry is outside the bundle directory: " + entryName);
+        }
+        return target;
+    }
+
     public record UnpackedBundle(Path dir, List<String> files) {
     }
