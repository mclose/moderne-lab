# Lab 8 Side A: the coding agent's sandbox. Only what a developer has: JDK 21, Maven, git, Node, the agent CLI.
# No Moderne CLI and no recipe cache, so the agent can't borrow the recipe's answer.
# Multi-arch base images: builds unchanged on x86 Linux and Apple Silicon.
FROM eclipse-temurin:21-jdk AS jdk21
FROM node:22-bookworm-slim
COPY --from=jdk21 /opt/java/openjdk /usr/lib/jvm/temurin-21
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates maven less jq \
 && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/temurin-21 PATH="/usr/lib/jvm/temurin-21/bin:${PATH}"
# Pinned so all five runs use the same agent build; auto-update off for the same reason.
ARG COPILOT_VERSION=1.0.105
RUN npm install -g --no-fund --no-audit "@github/copilot@${COPILOT_VERSION}" && npm cache clean --force
ENV COPILOT_AUTO_UPDATE=false
# uid 1001 = mclose on claude, so files in the bind-mounted /ws stay owned by you.
RUN useradd -m -u 1001 -s /bin/bash lab
USER lab
WORKDIR /home/lab
# ~/.m2 exists in the image so the moderne-lab-ab-m2 volume is created owned by lab, not root.
RUN mkdir -p /home/lab/.m2 && git config --global user.name lab8 && git config --global user.email lab8@localhost \
 && git config --global --add safe.directory '*'
